# Do not append /rest/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RESEND_API_KEY=
RESEND_FROM="NewNagarik <notifications@newnagarik.com>"

ADMIN_EMAIL=admin@newnagarik.local
ADMIN_PASSWORD=AdminSahih1
DEV_PHONE_OTP=123456
NEXT_PUBLIC_DEV_PHONE_OTP=123456

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=newnagarik-listings
