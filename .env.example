# Optional: pay-per-use fallback scrapers
APIFY_API_TOKEN=
APIFY_RENT_ACTOR_ID=
FIRECRAWL_API_KEY=

# Local/admin UI only. Never enable in production.
DEMO_EXTERNAL_LISTINGS=false

# Optional: Vercel cron for area listing refreshes.
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Macro trends LLM via OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
